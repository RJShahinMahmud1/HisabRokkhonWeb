rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserState(data, expectedUserId) {
      return data.keys().hasAll(['userId', 'stateStr', 'updatedAt']) &&
             data.keys().size() == 3 &&
             data.userId == expectedUserId &&
             data.stateStr is string && data.stateStr.size() <= 1048000 &&
             data.updatedAt == request.time;
    }

    match /userStates/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserState(incoming(), request.auth.uid);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserState(incoming(), request.auth.uid) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['stateStr', 'updatedAt']);
                       
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }
    
    match /global_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                    incoming().keys().hasAll(['senderId', 'senderName', 'text', 'createdAt']) &&
                    incoming().senderId == request.auth.uid &&
                    incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 1000 &&
                    incoming().senderName is string &&
                    incoming().createdAt == request.time;
      allow update, delete: if false; // no edit/delete for simplicity
    }
  }
}
