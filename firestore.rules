rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserState(data, expectedUserId) {
      return data.keys().hasAll(['userId', 'stateStr', 'updatedAt']) &&
             data.keys().size() == 3 &&
             data.userId == expectedUserId &&
             data.stateStr is string && data.stateStr.size() <= 1048000 &&
             data.updatedAt == request.time;
    }

    match /userStates/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserState(incoming(), request.auth.uid);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserState(incoming(), request.auth.uid) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['stateStr', 'updatedAt']);
                       
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }
    
    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /reports/{reportId} {
      allow read, write: if isSignedIn();
    }
    
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants && incoming().participants.size() == 2;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && request.auth.uid in incoming().participants;
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn() && 
          request.auth.uid == incoming().senderId &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          incoming().conversationId == conversationId;
        allow update: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
    
    match /posts/{postId} {
      allow read, write: if isSignedIn();
      
      match /comments/{commentId} {
        allow read, write: if isSignedIn();
      }
      
      match /likes/{likeId} {
        allow read, write: if isSignedIn();
      }
    }
    
    match /follows/{followId} {
      allow read, write: if isSignedIn();
    }
    
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }
    
    match /userReactions/{reactionId} {
      allow read, write: if isSignedIn();
    }
  }
}
